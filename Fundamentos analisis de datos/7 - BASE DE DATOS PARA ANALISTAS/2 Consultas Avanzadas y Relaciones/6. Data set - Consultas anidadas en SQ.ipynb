    "\n",
    "ventas_data = [\n",
    "    (1, 1, 50, '2024-01-01'),\n",
    "    (2, 1, 45, '2024-01-02'),\n",
    "    (3, 2, 15, '2024-01-01'),\n",
    "    (4, 2, 12, '2024-01-02'),\n",
    "    (5, 4, 25, '2024-01-01'),\n",
    "    (6, 4, 28, '2024-01-02'),\n",
