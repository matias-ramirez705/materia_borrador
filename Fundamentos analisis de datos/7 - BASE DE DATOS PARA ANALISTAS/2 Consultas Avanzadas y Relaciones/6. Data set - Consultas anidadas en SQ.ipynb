    "## SLIDE 15-19: Actividad Guiada - Análisis de Ventas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"ACTIVIDAD GUIADA: Análisis de Precios y Márgenes\")\n",
    "print(\"=\"*70 + \"\\n\")\n",
    "\n",
    "print(\"📋 Contexto: Analista de negocios en supermercado.\")\n",
    "print(\"Necesitas identificar productos premium (precio > promedio categoría)\\n\")\n",
    "\n",
    "# Consulta 1: Promedio por categoría\n",
    "print(\"✓ Paso 1: Calcular promedio de precio por categoría\")\n",
    "print(\"-\"*70)\n",
    "\n",
    "q1 = '''\n",
    "SELECT \n",
    "    c.nombre as categoria,\n",
    "    ROUND(AVG(p.precio_venta), 2) as precio_promedio\n",
    "FROM categorias c\n",
    "INNER JOIN productos p ON c.id = p.categoria_id\n",
    "GROUP BY c.id, c.nombre\n",
    "'''\n",
    "\n",
    "print(\"SQL:\")\n",
    "print(q1)\n",
    "print(\"\\nResultado:\")\n",
    "df_q1 = pd.read_sql(q1, conn)\n",
    "print(df_q1.to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Consulta 2: Productos por encima del promedio usando subconsulta\n",
    "print(\"\\n✓ Paso 2: Productos por encima del promedio de su categoría\")\n",
    "print(\"-\"*70)\n",
    "\n",
    "q2 = '''\n",
    "SELECT \n",
    "    p.nombre,\n",
    "    c.nombre as categoria,\n",
    "    p.precio_venta,\n",
    "    ROUND((SELECT AVG(precio_venta) FROM productos p2 \n",
    "           WHERE p2.categoria_id = p.categoria_id), 2) as promedio_categoria,\n",
    "    ROUND(p.precio_venta - (SELECT AVG(precio_venta) FROM productos p2 \n",
    "           WHERE p2.categoria_id = p.categoria_id), 2) as diferencia\n",
    "FROM productos p\n",
    "INNER JOIN categorias c ON p.categoria_id = c.id\n",
    "WHERE p.precio_venta > (SELECT AVG(precio_venta) FROM productos p2 \n",
    "                         WHERE p2.categoria_id = p.categoria_id)\n",
    "ORDER BY c.nombre, p.precio_venta DESC\n",
    "'''\n",
    "\n",
    "print(\"SQL (con subconsultas correlacionadas):\")\n",
    "print(q2[:200] + \"...\\n\")\n",
    "print(\"Resultado:\")\n",
    "df_q2 = pd.read_sql(q2, conn)\n",
    "print(df_q2.to_string())\n",
    "print(\"\\n✓ Estos productos tienen precio superior al promedio de su categoría\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Consulta 3: Calcular margen\n",
    "print(\"\\n✓ Paso 3: Productos con margen superior a 40%\")\n",
    "print(\"-\"*70)\n",
    "\n",
    "q3 = '''\n",
    "SELECT \n",
    "    nombre,\n",
    "    precio_venta,\n",
    "    precio_costo,\n",
    "    ROUND((precio_venta - precio_costo) / precio_costo * 100, 2) as margen_pct\n",
    "FROM productos\n",
    "WHERE (precio_venta - precio_costo) / precio_costo > 0.40\n",
    "ORDER BY margen_pct DESC\n",
    "'''\n",
    "\n",
    "print(\"SQL:\")\n",
    "print(q3)\n",
    "print(\"\\nResultado:\")\n",
    "df_q3 = pd.read_sql(q3, conn)\n",
    "print(df_q3.to_string())\n",
    "print(f\"\\n✓ {len(df_q3)} productos tienen margen > 40%\")"
   ]
  },
