   "source": [
    "## SLIDE 12-14: Subconsultas vs JOINs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"SLIDE 12-14: Subconsultas vs JOINs\")\n",
    "print(\"=\"*70 + \"\\n\")\n",
    "\n",
    "comparacion = {\n",
    "    'Aspecto': ['Legibilidad', 'Rendimiento', 'Modularidad', 'Casos de Uso'],\n",
    "    'Subconsulta': [\n",
    "        'Alta (lógica encapsulada)',\n",
    "        'Adecuado en consultas simples',\n",
    "        'Alta (puede reutilizarse)',\n",
    "        'Comparar vs agregación'\n",
    "    ],\n",
    "    'JOIN': [\n",
    "        'Menor con muchas relaciones',\n",
    "        'Superior en grandes volúmenes',\n",
    "        'Menor (inline)',\n",
    "        'Combinar registros relacionados'\n",
    "    ]\n",
    "}\n",
    "\n",
    "df_comp = pd.DataFrame(comparacion)\n",
    "print(df_comp.to_string(index=False))\n",
    "\n",
    "print(\"\\n\" + \"-\"*70)\n",
    "print(\"Ejemplo: Mismo problema resuelto 2 formas\\n\")\n",
    "\n",
    "# Problema: Productos en categoría Lácteos\n",
    "print(\"Problema: Obtener todos los productos de la categoría 'Lácteos'\\n\")\n",
    "\n",
    "print(\"SOLUCIÓN 1: CON SUBCONSULTA\")\n",
    "query_sub = '''\n",
    "SELECT nombre, precio_venta\n",
    "FROM productos\n",
    "WHERE categoria_id = (SELECT id FROM categorias WHERE nombre = 'Lácteos')\n",
    "'''\n",
    "print(query_sub)\n",
    "df_sub = pd.read_sql(query_sub, conn)\n",
    "print(\"Resultado:\", len(df_sub), \"registros\\n\")\n",
    "\n",
    "print(\"SOLUCIÓN 2: CON JOIN\")\n",
    "query_join = '''\n",
    "SELECT p.nombre, p.precio_venta\n",
    "FROM productos p\n",
    "INNER JOIN categorias c ON p.categoria_id = c.id\n",
    "WHERE c.nombre = 'Lácteos'\n",
    "'''\n",
    "print(query_join)\n",
    "df_join = pd.read_sql(query_join, conn)\n",
    "print(\"Resultado:\", len(df_join), \"registros\\n\")\n",
    "\n",
    "print(\"✓ En este caso, JOIN es más directo\")"
   ]
  },
