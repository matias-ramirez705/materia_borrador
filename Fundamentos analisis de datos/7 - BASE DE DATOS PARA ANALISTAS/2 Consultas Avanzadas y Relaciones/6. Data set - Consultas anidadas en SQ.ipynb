    "    (4, 'Carne Molida', 2, 8.50, 5.00),\n",
    "    (5, 'Pechuga Pollo', 2, 7.80, 4.50),\n",
    "    (6, 'Costilla Cerdo', 2, 9.20, 5.50),\n",
    "    (7, 'Pan Blanco', 3, 1.50, 0.80),\n",
    "    (8, 'Pan Integral', 3, 1.80, 0.95),\n",
    "    (9, 'Croissant', 3, 2.50, 1.30)\n",
    "]\n",
    "\n",
    "cursor.executemany('INSERT INTO productos VALUES (?, ?, ?, ?, ?)', productos_data)\n",
    "\n",
    "conn.commit()\n",
    "print(\"✓ Tablas 'categorias' y 'productos' creadas\\n\")\n",
    "\n",
    "df_prod = pd.read_sql('SELECT * FROM productos', conn)\n",
    "print(\"Productos:\")\n",
    "print(df_prod.to_string())"
   ]
