    "    (8, 7, 95, '2024-01-02')\n",
    "]\n",
    "\n",
    "cursor.executemany('INSERT INTO ventas VALUES (?, ?, ?, ?)', ventas_data)\n",
    "conn.commit()\n",
    "\n",
